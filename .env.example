DJANGO_SECRET_KEY=change_this_to_a_long_random_string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# SQLite by default — no DB server needed, just a local db.sqlite3 file.
DB_ENGINE=sqlite

# Only needed if you switch DB_ENGINE=mysql:
DB_NAME=socobys_ims
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
